__pycache__/
*.egg-info/
.pytest_cache/
.venv/
/data/
models/checkpoints/
models/transformer/smoke/

# Hyperparameter sweep artifacts (models/sweeps/) are experiments, not
# production models -- only the summary leaderboard (results.json) is
# committed, so it's cheap to see what a sweep found without carrying every
# combo's checkpoints/weights/scaler in git. Production artifacts used by
# the site/bake-off still live committed under models/transformer/.
# Git won't recurse into an ignored directory to apply per-file negations,
# so directories must be explicitly re-included (the `**/` line) before the
# results.json re-include pattern can take effect -- verified with
# `git check-ignore` on both a fake artifact path and a results.json path.
/models/sweeps/**
!/models/sweeps/**/
!/models/sweeps/**/results.json
models_artifacts.zip

# Draft-strategy backtest inputs (models/backtests/worlds*/): per-season board
# + full weekly answer key, ~3MB and fully regenerable from committed code and
# the cached nflverse/FantasyPros pulls:
#   python -m ffmodel.eval.draft_world --seasons 2021 2022 2023 2024 2025
# The summary reports (draft_sim*.json) ARE committed -- they are the result.
/models/backtests/worlds/
/models/backtests/worlds_tf/
/models/backtests/worlds_tf_cal/
/models/backtests/worlds_tf_base/

# Brainstorming scratch (visual companion screens, SDD progress ledger).
.superpowers/

# Local secrets. The FantasyPros key lives here, never in a tracked file --
# this repo is public, and scraped free-tier keys get burned fast. `.env` is
# ignored; `.env.example` is committed as the template and must stay
# value-free.
.env
.env.*
!.env.example

# Keeper snapshots (tools/pull_keepers.cjs) describe a specific private
# league: other managers' Sleeper handles and who they kept. This repo is
# public and those are third parties, so the snapshot stays local. It is one
# command to regenerate and the sim names its source in the report metadata:
#   node tools/pull_keepers.cjs --league <id> --out data_snapshots/keepers_<date>.json
data_snapshots/keepers_*.json

# codex review runs drop pytest temp dirs here (its Windows sandbox is
# elevated, so they are not deletable from an ordinary shell)
.review/

# Template. Copy to `.env` and fill in real values; `.env` is git-ignored.
#
# FantasyPros API key. Free tier is 50 requests/day, so anything that reads it
# must cache -- see src/ffmodel/data/rankings.py for the caching pattern the
# rest of the project uses.
#
# NOT currently required by any code path: ECR arrives via nflverse's mirrored
# FantasyPros scrapes (nflreadpy.load_ff_rankings) and ADP from a committed
# snapshot, and the weekly GitHub Actions run deliberately has no live
# FantasyPros dependency. This exists so a local experiment has somewhere to
# put the key other than a source file.
FANTASYPROS_API_KEY=
